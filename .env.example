# Copy to .env (or set in your host's dashboard). Never commit real values.

# Required in production: the public HTTPS origin, and a random secret of 32+ characters
# (for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
BETTER_AUTH_URL=https://elsewhere.example.com
BETTER_AUTH_SECRET=

# SQLite file on durable storage (a mounted volume on container hosts).
DATABASE_PATH=.data/elsewhere.sqlite

# Listener. Container platforms usually need HOST=0.0.0.0 and provide PORT.
HOST=127.0.0.1
PORT=5174

# Set to true when running behind a reverse proxy or platform load balancer, so sign-in
# rate limits apply per visitor instead of to everyone at once.
TRUST_PROXY=false

# Optional: live concerts (Ticketmaster Discovery API).
TICKETMASTER_API_KEY=

# Optional: account email (verification and password reset) through Resend.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
