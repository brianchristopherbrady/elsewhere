{
  "name": "elsewhere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/compress-dist.mjs",
    "build:pages": "tsc -b && vite build && node --experimental-strip-types scripts/snapshot-feeds.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --experimental-strip-types server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:discovery": "node --experimental-strip-types scripts/review-discovery.ts",
    "verify:staples": "node --experimental-strip-types scripts/verify-staples.ts && node --experimental-strip-types scripts/describe-staples.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "html-to-text": "^10.0.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
